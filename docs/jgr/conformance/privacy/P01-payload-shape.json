{
  "$schema": "./schema.json",
  "id": "P01",
  "kind": "payload",
  "description": "L2 payload v1 before encryption: {\"v\":1,\"repo\":\"<display name>\",\"branch\":\"<branch>\"}, either name absent as a missing key; then padded with spaces to 256 bytes (E03).",
  "contract": "ADR-0018 (e3a2ad5) decision 4 L2 payload v1, Padding",
  "ambiguities": ["G5", "G8", "G12"],
  "cases": [
    {
      "label": "repo-and-branch",
      "note": "both names: key order v, repo, branch; compact JSON",
      "input": {
        "repo": "javi-dog",
        "branch": "main",
        "canary": false
      },
      "expect": {
        "payload": {
          "v": 1,
          "repo": "javi-dog",
          "branch": "main"
        },
        "json": "{\"v\":1,\"repo\":\"javi-dog\",\"branch\":\"main\"}",
        "jsonByteLength": 41,
        "paddedByteLength": 256,
        "paddedSha256Hex": "a747b9271d12b40b68617ab92b36d51536dc9f3eaa29d2e3c609c78eeed82ac6",
        "paddedHex": ""
      }
    },
    {
      "label": "repo-only",
      "note": "detached HEAD: no branch key at all (not null, not \"\")",
      "input": {
        "repo": "javi-dog",
        "branch": null,
        "canary": false
      },
      "expect": {
        "payload": {
          "v": 1,
          "repo": "javi-dog"
        },
        "json": "{\"v\":1,\"repo\":\"javi-dog\"}",
        "jsonByteLength": 25,
        "paddedByteLength": 256,
        "paddedSha256Hex": "fceb0e4455b32c0d9c3a2b287fcd20f8a35e9112af734e1d1593dd32474edc0b",
        "paddedHex": ""
      }
    },
    {
      "label": "branch-only",
      "note": "repo absent",
      "input": {
        "repo": null,
        "branch": "main",
        "canary": false
      },
      "expect": {
        "payload": {
          "v": 1,
          "branch": "main"
        },
        "json": "{\"v\":1,\"branch\":\"main\"}",
        "jsonByteLength": 23,
        "paddedByteLength": 256,
        "paddedSha256Hex": "d2490594401f63dfef6344e7d301bc9a052c7fadffec61f9764b91e64f1a13a0",
        "paddedHex": ""
      }
    },
    {
      "label": "neither",
      "note": "both absent: {\"v\":1} [G8]",
      "input": {
        "repo": null,
        "branch": null,
        "canary": false
      },
      "expect": {
        "payload": {
          "v": 1
        },
        "json": "{\"v\":1}",
        "jsonByteLength": 7,
        "paddedByteLength": 256,
        "paddedSha256Hex": "b6937d3f3f86965f99c18fd4482ceb28c69f59155e8fd1ae54ed5d1d668bdaf1",
        "paddedHex": ""
      }
    },
    {
      "label": "json-escapes",
      "note": "quote and backslash escaped by JSON; nothing else changes [G12]",
      "input": {
        "repo": "my \"quoted\" repo\\x",
        "branch": "fix/a\"b",
        "canary": false
      },
      "expect": {
        "payload": {
          "v": 1,
          "repo": "my \"quoted\" repo\\x",
          "branch": "fix/a\"b"
        },
        "json": "{\"v\":1,\"repo\":\"my \\\"quoted\\\" repo\\\\x\",\"branch\":\"fix/a\\\"b\"}",
        "jsonByteLength": 58,
        "paddedByteLength": 256,
        "paddedSha256Hex": "bbc1ea8907713a505675841ebecd182fba311f0984c8a271d6cd811e873a1eda",
        "paddedHex": ""
      }
    },
    {
      "label": "non-ascii-raw",
      "note": "non-ASCII written as raw UTF-8 (ECMAScript JSON.stringify), not \\u escapes [G12]",
      "input": {
        "repo": "caf\u00e9-\ud83d\udc36",
        "branch": "\u4e3b\u5e72",
        "canary": false
      },
      "expect": {
        "payload": {
          "v": 1,
          "repo": "caf\u00e9-\ud83d\udc36",
          "branch": "\u4e3b\u5e72"
        },
        "json": "{\"v\":1,\"repo\":\"caf\u00e9-\ud83d\udc36\",\"branch\":\"\u4e3b\u5e72\"}",
        "jsonByteLength": 45,
        "paddedByteLength": 256,
        "paddedSha256Hex": "f3ff90b4f47edfb19d26ede7b12ce2db08efea113fa30c837e309eab058bdfb5",
        "paddedHex": ""
      }
    },
    {
      "label": "nfd-input",
      "note": "NFD repo name is NFC-normalised in the payload [G5]",
      "input": {
        "repo": "cafe\u0301",
        "branch": "main",
        "canary": false
      },
      "expect": {
        "payload": {
          "v": 1,
          "repo": "caf\u00e9",
          "branch": "main"
        },
        "json": "{\"v\":1,\"repo\":\"caf\u00e9\",\"branch\":\"main\"}",
        "jsonByteLength": 38,
        "paddedByteLength": 256,
        "paddedSha256Hex": "87c2391c5816a5e0eb5376d32ea51f464a26833a00bedd34e36a2d5de5532786",
        "paddedHex": ""
      }
    },
    {
      "label": "bidi-kept",
      "note": "bidi controls stay in the payload (removed only when displayed)",
      "input": {
        "repo": "javi\u202edog",
        "branch": "main\u2066x\u2069",
        "canary": false
      },
      "expect": {
        "payload": {
          "v": 1,
          "repo": "javi\u202edog",
          "branch": "main\u2066x\u2069"
        },
        "json": "{\"v\":1,\"repo\":\"javi\u202edog\",\"branch\":\"main\u2066x\u2069\"}",
        "jsonByteLength": 50,
        "paddedByteLength": 256,
        "paddedSha256Hex": "24dfa7a1b20b6388b56c8ebfbfff452c86ca437ed1f07d6f9b1ffde4682bc4c5",
        "paddedHex": ""
      }
    }
  ]
}
