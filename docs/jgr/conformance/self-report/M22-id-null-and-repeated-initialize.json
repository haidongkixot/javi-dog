{
  "$schema": "./schema.json",
  "id": "M22",
  "kind": "mcp",
  "description": "A request with \"id\": null gets -32600 with id null, before and after initialize; a second initialize is answered like the first; the server keeps working.",
  "contract": "ADR-0017 (2d4dcc2 + QA spec gaps) decision 1 Message rules (\"A request with \"id\": null gets -32600 with id: null. A second initialize is answered like the first (QA gap G14)\")",
  "ambiguities": [],
  "server": {
    "hooksInstalled": true
  },
  "steps": [
    {
      "note": "ping with id null before initialize → -32600, id null",
      "send": {
        "jsonrpc": "2.0",
        "id": null,
        "method": "ping"
      },
      "rawLine": null,
      "expect": {
        "jsonrpc": "2.0",
        "id": null,
        "error": {
          "code": -32600,
          "message": {
            "$match": "string"
          },
          "data": {
            "$match": "any",
            "optional": true
          }
        }
      }
    },
    {
      "note": "initialize 2025-11-25",
      "send": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "initialize",
        "params": {
          "protocolVersion": "2025-11-25",
          "capabilities": {},
          "clientInfo": {
            "name": "conformance-client",
            "version": "1.0.0"
          }
        }
      },
      "rawLine": null,
      "expect": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "protocolVersion": "2025-11-25",
          "capabilities": {
            "tools": {
              "listChanged": false
            }
          },
          "serverInfo": {
            "name": "javi",
            "version": {
              "$match": "string",
              "minLength": 1
            }
          },
          "instructions": {
            "$match": "string",
            "minLength": 1,
            "maxLength": 1000,
            "containsAll": ["report_status", "report_task"]
          }
        }
      }
    },
    {
      "note": "notifications/initialized: no response",
      "send": {
        "jsonrpc": "2.0",
        "method": "notifications/initialized"
      },
      "rawLine": null,
      "expect": null
    },
    {
      "note": "ping with id null → -32600, id null",
      "send": {
        "jsonrpc": "2.0",
        "id": null,
        "method": "ping"
      },
      "rawLine": null,
      "expect": {
        "jsonrpc": "2.0",
        "id": null,
        "error": {
          "code": -32600,
          "message": {
            "$match": "string"
          },
          "data": {
            "$match": "any",
            "optional": true
          }
        }
      }
    },
    {
      "note": "tools/call with id null → -32600, id null, arguments never echoed",
      "send": {
        "jsonrpc": "2.0",
        "id": null,
        "method": "tools/call",
        "params": {
          "name": "report_status",
          "arguments": {
            "status": "SENTINEL_STATUS_M22"
          }
        }
      },
      "rawLine": null,
      "expect": {
        "jsonrpc": "2.0",
        "id": null,
        "error": {
          "code": -32600,
          "message": {
            "$match": "string"
          },
          "data": {
            "$match": "any",
            "optional": true
          }
        }
      }
    },
    {
      "note": "second initialize, same request → same answer",
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "initialize",
        "params": {
          "protocolVersion": "2025-11-25",
          "capabilities": {},
          "clientInfo": {
            "name": "conformance-client",
            "version": "1.0.0"
          }
        }
      },
      "rawLine": null,
      "expect": {
        "jsonrpc": "2.0",
        "id": 2,
        "result": {
          "protocolVersion": "2025-11-25",
          "capabilities": {
            "tools": {
              "listChanged": false
            }
          },
          "serverInfo": {
            "name": "javi",
            "version": {
              "$match": "string",
              "minLength": 1
            }
          },
          "instructions": {
            "$match": "string",
            "minLength": 1,
            "maxLength": 1000,
            "containsAll": ["report_status", "report_task"]
          }
        }
      }
    },
    {
      "note": "notifications/initialized again",
      "send": {
        "jsonrpc": "2.0",
        "method": "notifications/initialized"
      },
      "rawLine": null,
      "expect": null
    },
    {
      "note": "tools/list still works",
      "send": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "tools/list"
      },
      "rawLine": null,
      "expect": {
        "jsonrpc": "2.0",
        "id": 3,
        "result": {
          "$open": true,
          "tools": {
            "$match": "unorderedArray",
            "items": [
              {
                "$open": true,
                "name": "report_status",
                "description": {
                  "$match": "string",
                  "minLength": 1,
                  "optional": true
                },
                "inputSchema": {
                  "$open": true,
                  "type": "object",
                  "properties": {
                    "status": {
                      "$open": true,
                      "type": "string",
                      "enum": {
                        "$match": "setEquals",
                        "values": ["working", "waiting", "blocked", "idle", "completed", "failed"]
                      }
                    },
                    "reason": {
                      "$open": true,
                      "type": "string",
                      "enum": {
                        "$match": "setEquals",
                        "values": [
                          "needs_input",
                          "needs_approval",
                          "missing_credentials",
                          "missing_access",
                          "tests_failing",
                          "ci_failing",
                          "rate_limited",
                          "dependency_down",
                          "conflicting_requirements",
                          "other"
                        ]
                      }
                    }
                  },
                  "required": {
                    "$match": "setEquals",
                    "values": ["status"]
                  },
                  "additionalProperties": false
                },
                "annotations": {
                  "readOnlyHint": false,
                  "destructiveHint": false,
                  "idempotentHint": true,
                  "openWorldHint": false
                }
              },
              {
                "$open": true,
                "name": "report_task",
                "description": {
                  "$match": "string",
                  "minLength": 1,
                  "optional": true
                },
                "inputSchema": {
                  "$open": true,
                  "type": "object",
                  "properties": {
                    "phase": {
                      "$open": true,
                      "type": "string",
                      "enum": {
                        "$match": "setEquals",
                        "values": ["started", "completed", "failed"]
                      }
                    },
                    "kind": {
                      "$open": true,
                      "type": "string",
                      "enum": {
                        "$match": "setEquals",
                        "values": [
                          "plan",
                          "research",
                          "implement",
                          "test",
                          "debug",
                          "review",
                          "docs",
                          "build",
                          "deploy",
                          "other"
                        ]
                      }
                    }
                  },
                  "required": {
                    "$match": "setEquals",
                    "values": ["phase", "kind"]
                  },
                  "additionalProperties": false
                },
                "annotations": {
                  "readOnlyHint": false,
                  "destructiveHint": false,
                  "idempotentHint": true,
                  "openWorldHint": false
                }
              }
            ]
          }
        }
      }
    },
    {
      "note": "a valid call still succeeds",
      "send": {
        "jsonrpc": "2.0",
        "id": 4,
        "method": "tools/call",
        "params": {
          "name": "report_status",
          "arguments": {
            "status": "idle"
          }
        }
      },
      "rawLine": null,
      "expect": {
        "jsonrpc": "2.0",
        "id": 4,
        "result": {
          "$open": true,
          "content": [
            {
              "$open": true,
              "type": "text",
              "text": {
                "$match": "string",
                "minLength": 1,
                "noDeliveryClaim": true
              }
            }
          ],
          "isError": {
            "$match": "oneOf",
            "values": [false],
            "optional": true
          }
        }
      }
    }
  ],
  "stderrForbidden": [
    "initialize",
    "notifications/initialized",
    "ping",
    "tools/call",
    "tools/list"
  ],
  "absentStrings": ["SENTINEL_STATUS_M22"]
}
