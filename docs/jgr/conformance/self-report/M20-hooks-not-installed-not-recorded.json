{
  "$schema": "./schema.json",
  "id": "M20",
  "kind": "mcp",
  "description": "With javi's hooks for the platform and project not installed, valid calls to either tool answer isError:true with the constant \"not recorded: javi hooks are not installed for this project\"; invalid input still gets the validation constant first, and tools/list is unchanged.",
  "contract": "ADR-0017 (c25cf2d) decision 2 Honest answer (\"When they are not installed, the call answers isError with a constant …\"); Strict arguments (\"the arguments are validated first; only valid input is then checked against the hooks state (QA gap G3). tools/list does not depend on the hooks state\"); server option hooksInstalled:false",
  "ambiguities": [],
  "server": {
    "hooksInstalled": false
  },
  "steps": [
    {
      "note": "initialize 2025-11-25",
      "send": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "initialize",
        "params": {
          "protocolVersion": "2025-11-25",
          "capabilities": {},
          "clientInfo": {
            "name": "conformance-client",
            "version": "1.0.0"
          }
        }
      },
      "rawLine": null,
      "expect": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "protocolVersion": "2025-11-25",
          "capabilities": {
            "tools": {
              "listChanged": false
            }
          },
          "serverInfo": {
            "name": "javi",
            "version": {
              "$match": "string",
              "minLength": 1
            }
          },
          "instructions": {
            "$match": "string",
            "minLength": 1,
            "maxLength": 1000,
            "containsAll": ["report_status", "report_task"]
          }
        }
      }
    },
    {
      "note": "notifications/initialized: no response",
      "send": {
        "jsonrpc": "2.0",
        "method": "notifications/initialized"
      },
      "rawLine": null,
      "expect": null
    },
    {
      "note": "tools/list is unaffected by the hooks state",
      "send": {
        "jsonrpc": "2.0",
        "id": 10,
        "method": "tools/list"
      },
      "rawLine": null,
      "expect": {
        "jsonrpc": "2.0",
        "id": 10,
        "result": {
          "$open": true,
          "tools": {
            "$match": "unorderedArray",
            "items": [
              {
                "$open": true,
                "name": "report_status",
                "description": {
                  "$match": "string",
                  "minLength": 1,
                  "optional": true
                },
                "inputSchema": {
                  "$open": true,
                  "type": "object",
                  "properties": {
                    "status": {
                      "$open": true,
                      "type": "string",
                      "enum": {
                        "$match": "setEquals",
                        "values": ["working", "waiting", "blocked", "idle", "completed", "failed"]
                      }
                    },
                    "reason": {
                      "$open": true,
                      "type": "string",
                      "enum": {
                        "$match": "setEquals",
                        "values": [
                          "needs_input",
                          "needs_approval",
                          "missing_credentials",
                          "missing_access",
                          "tests_failing",
                          "ci_failing",
                          "rate_limited",
                          "dependency_down",
                          "conflicting_requirements",
                          "other"
                        ]
                      }
                    }
                  },
                  "required": {
                    "$match": "setEquals",
                    "values": ["status"]
                  },
                  "additionalProperties": false
                },
                "annotations": {
                  "readOnlyHint": false,
                  "destructiveHint": false,
                  "idempotentHint": true,
                  "openWorldHint": false
                }
              },
              {
                "$open": true,
                "name": "report_task",
                "description": {
                  "$match": "string",
                  "minLength": 1,
                  "optional": true
                },
                "inputSchema": {
                  "$open": true,
                  "type": "object",
                  "properties": {
                    "phase": {
                      "$open": true,
                      "type": "string",
                      "enum": {
                        "$match": "setEquals",
                        "values": ["started", "completed", "failed"]
                      }
                    },
                    "kind": {
                      "$open": true,
                      "type": "string",
                      "enum": {
                        "$match": "setEquals",
                        "values": [
                          "plan",
                          "research",
                          "implement",
                          "test",
                          "debug",
                          "review",
                          "docs",
                          "build",
                          "deploy",
                          "other"
                        ]
                      }
                    }
                  },
                  "required": {
                    "$match": "setEquals",
                    "values": ["phase", "kind"]
                  },
                  "additionalProperties": false
                },
                "annotations": {
                  "readOnlyHint": false,
                  "destructiveHint": false,
                  "idempotentHint": true,
                  "openWorldHint": false
                }
              }
            ]
          }
        }
      }
    },
    {
      "note": "invalid report_status → the validation constant, not \"not recorded\"",
      "send": {
        "jsonrpc": "2.0",
        "id": 11,
        "method": "tools/call",
        "params": {
          "name": "report_status",
          "arguments": {
            "status": "working",
            "reason": "needs_input"
          }
        }
      },
      "rawLine": null,
      "expect": {
        "jsonrpc": "2.0",
        "id": 11,
        "result": {
          "$open": true,
          "content": [
            {
              "$open": true,
              "type": "text",
              "text": {
                "$match": "string",
                "minLength": 1,
                "label": "report_status.invalid",
                "containsAll": ["working", "waiting", "blocked", "idle", "completed", "failed"]
              }
            }
          ],
          "isError": true
        }
      }
    },
    {
      "note": "invalid report_task with a sentinel → the validation constant",
      "send": {
        "jsonrpc": "2.0",
        "id": 12,
        "method": "tools/call",
        "params": {
          "name": "report_task",
          "arguments": {
            "phase": "SENTINEL_PHASE_M20",
            "kind": "test"
          }
        }
      },
      "rawLine": null,
      "expect": {
        "jsonrpc": "2.0",
        "id": 12,
        "result": {
          "$open": true,
          "content": [
            {
              "$open": true,
              "type": "text",
              "text": {
                "$match": "string",
                "minLength": 1,
                "label": "report_task.invalid",
                "containsAll": [
                  "started",
                  "completed",
                  "failed",
                  "plan",
                  "research",
                  "implement",
                  "test",
                  "debug",
                  "review",
                  "docs",
                  "build",
                  "deploy",
                  "other"
                ]
              }
            }
          ],
          "isError": true
        }
      }
    },
    {
      "note": "valid report_status",
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "tools/call",
        "params": {
          "name": "report_status",
          "arguments": {
            "status": "blocked",
            "reason": "missing_credentials"
          }
        }
      },
      "rawLine": null,
      "expect": {
        "jsonrpc": "2.0",
        "id": 2,
        "result": {
          "$open": true,
          "content": [
            {
              "$open": true,
              "type": "text",
              "text": {
                "$match": "string",
                "startsWith": "not recorded: javi hooks are not installed for this project",
                "label": "not-recorded"
              }
            }
          ],
          "isError": true
        }
      }
    },
    {
      "note": "valid report_task",
      "send": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "tools/call",
        "params": {
          "name": "report_task",
          "arguments": {
            "phase": "started",
            "kind": "test"
          }
        }
      },
      "rawLine": null,
      "expect": {
        "jsonrpc": "2.0",
        "id": 3,
        "result": {
          "$open": true,
          "content": [
            {
              "$open": true,
              "type": "text",
              "text": {
                "$match": "string",
                "startsWith": "not recorded: javi hooks are not installed for this project",
                "label": "not-recorded"
              }
            }
          ],
          "isError": true
        }
      }
    },
    {
      "note": "valid report_status without reason",
      "send": {
        "jsonrpc": "2.0",
        "id": 4,
        "method": "tools/call",
        "params": {
          "name": "report_status",
          "arguments": {
            "status": "working"
          }
        }
      },
      "rawLine": null,
      "expect": {
        "jsonrpc": "2.0",
        "id": 4,
        "result": {
          "$open": true,
          "content": [
            {
              "$open": true,
              "type": "text",
              "text": {
                "$match": "string",
                "startsWith": "not recorded: javi hooks are not installed for this project",
                "label": "not-recorded"
              }
            }
          ],
          "isError": true
        }
      }
    }
  ],
  "stderrForbidden": ["initialize", "notifications/initialized", "tools/call", "tools/list"],
  "absentStrings": ["SENTINEL_PHASE_M20"]
}
