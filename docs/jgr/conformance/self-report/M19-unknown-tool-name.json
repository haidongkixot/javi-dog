{
  "$schema": "./schema.json",
  "id": "M19",
  "kind": "mcp",
  "description": "tools/call with a tool name that is not report_status or report_task gets -32602, including the client-side prefixed name and case variants; the name is never echoed.",
  "contract": "ADR-0017 (at 2d4dcc2) decision 1 Errors (\"An unknown tool name gets -32602\")",
  "ambiguities": [],
  "server": {
    "hooksInstalled": true
  },
  "steps": [
    {
      "note": "initialize 2025-11-25",
      "send": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "initialize",
        "params": {
          "protocolVersion": "2025-11-25",
          "capabilities": {},
          "clientInfo": {
            "name": "conformance-client",
            "version": "1.0.0"
          }
        }
      },
      "rawLine": null,
      "expect": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "protocolVersion": "2025-11-25",
          "capabilities": {
            "tools": {
              "listChanged": false
            }
          },
          "serverInfo": {
            "name": "javi",
            "version": {
              "$match": "string",
              "minLength": 1
            }
          },
          "instructions": {
            "$match": "string",
            "minLength": 1,
            "maxLength": 1000,
            "containsAll": ["report_status", "report_task"]
          }
        }
      }
    },
    {
      "note": "notifications/initialized: no response",
      "send": {
        "jsonrpc": "2.0",
        "method": "notifications/initialized"
      },
      "rawLine": null,
      "expect": null
    },
    {
      "note": "sentinel tool name",
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "tools/call",
        "params": {
          "name": "report_SENTINEL_TOOL_M19",
          "arguments": {
            "status": "working"
          }
        }
      },
      "rawLine": null,
      "expect": {
        "jsonrpc": "2.0",
        "id": 2,
        "error": {
          "code": -32602,
          "message": {
            "$match": "string"
          },
          "data": {
            "$match": "any",
            "optional": true
          }
        }
      }
    },
    {
      "note": "client-side prefixed name",
      "send": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "tools/call",
        "params": {
          "name": "mcp__javi__report_status",
          "arguments": {
            "status": "working"
          }
        }
      },
      "rawLine": null,
      "expect": {
        "jsonrpc": "2.0",
        "id": 3,
        "error": {
          "code": -32602,
          "message": {
            "$match": "string"
          },
          "data": {
            "$match": "any",
            "optional": true
          }
        }
      }
    },
    {
      "note": "Gemini-style prefixed name",
      "send": {
        "jsonrpc": "2.0",
        "id": 4,
        "method": "tools/call",
        "params": {
          "name": "mcp_javi_report_task",
          "arguments": {
            "phase": "started",
            "kind": "test"
          }
        }
      },
      "rawLine": null,
      "expect": {
        "jsonrpc": "2.0",
        "id": 4,
        "error": {
          "code": -32602,
          "message": {
            "$match": "string"
          },
          "data": {
            "$match": "any",
            "optional": true
          }
        }
      }
    },
    {
      "note": "wrong case",
      "send": {
        "jsonrpc": "2.0",
        "id": 5,
        "method": "tools/call",
        "params": {
          "name": "Report_Status",
          "arguments": {
            "status": "working"
          }
        }
      },
      "rawLine": null,
      "expect": {
        "jsonrpc": "2.0",
        "id": 5,
        "error": {
          "code": -32602,
          "message": {
            "$match": "string"
          },
          "data": {
            "$match": "any",
            "optional": true
          }
        }
      }
    },
    {
      "note": "empty name",
      "send": {
        "jsonrpc": "2.0",
        "id": 6,
        "method": "tools/call",
        "params": {
          "name": "",
          "arguments": {}
        }
      },
      "rawLine": null,
      "expect": {
        "jsonrpc": "2.0",
        "id": 6,
        "error": {
          "code": -32602,
          "message": {
            "$match": "string"
          },
          "data": {
            "$match": "any",
            "optional": true
          }
        }
      }
    },
    {
      "note": "valid call still succeeds",
      "send": {
        "jsonrpc": "2.0",
        "id": 7,
        "method": "tools/call",
        "params": {
          "name": "report_status",
          "arguments": {
            "status": "idle"
          }
        }
      },
      "rawLine": null,
      "expect": {
        "jsonrpc": "2.0",
        "id": 7,
        "result": {
          "$open": true,
          "content": [
            {
              "$open": true,
              "type": "text",
              "text": {
                "$match": "string",
                "minLength": 1,
                "noDeliveryClaim": true
              }
            }
          ],
          "isError": {
            "$match": "oneOf",
            "values": [false],
            "optional": true
          }
        }
      }
    }
  ],
  "stderrForbidden": ["initialize", "notifications/initialized", "tools/call"],
  "absentStrings": ["SENTINEL_TOOL_M19"]
}
