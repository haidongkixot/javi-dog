{
  "$schema": "./schema.json",
  "id": "M11",
  "kind": "mcp",
  "description": "A line that is not valid JSON gets -32700 with id null, before and after initialize, even when an id is visible in the broken text; the text is never echoed.",
  "contract": "ADR-0017 (2d4dcc2 + QA spec gaps) decision 1 Errors (\"Malformed JSON gets -32700 with id: null\"), stderr (no parse excerpts)",
  "ambiguities": [],
  "server": {
    "hooksInstalled": true
  },
  "steps": [
    {
      "note": "truncated initialize before initialize",
      "send": null,
      "rawLine": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"SENTINEL_PARSE_M11_A\"",
      "expect": {
        "jsonrpc": "2.0",
        "id": null,
        "error": {
          "code": -32700,
          "message": {
            "$match": "string"
          },
          "data": {
            "$match": "any",
            "optional": true
          }
        }
      }
    },
    {
      "note": "plain text",
      "send": null,
      "rawLine": "SENTINEL_PARSE_M11_B is not json",
      "expect": {
        "jsonrpc": "2.0",
        "id": null,
        "error": {
          "code": -32700,
          "message": {
            "$match": "string"
          },
          "data": {
            "$match": "any",
            "optional": true
          }
        }
      }
    },
    {
      "note": "initialize 2025-11-25",
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "initialize",
        "params": {
          "protocolVersion": "2025-11-25",
          "capabilities": {},
          "clientInfo": {
            "name": "conformance-client",
            "version": "1.0.0"
          }
        }
      },
      "rawLine": null,
      "expect": {
        "jsonrpc": "2.0",
        "id": 2,
        "result": {
          "protocolVersion": "2025-11-25",
          "capabilities": {
            "tools": {
              "listChanged": false
            }
          },
          "serverInfo": {
            "name": "javi",
            "version": {
              "$match": "string",
              "minLength": 1
            }
          },
          "instructions": {
            "$match": "string",
            "minLength": 1,
            "maxLength": 1000,
            "containsAll": ["report_status", "report_task"]
          }
        }
      }
    },
    {
      "note": "notifications/initialized: no response",
      "send": {
        "jsonrpc": "2.0",
        "method": "notifications/initialized"
      },
      "rawLine": null,
      "expect": null
    },
    {
      "note": "trailing comma, id visible",
      "send": null,
      "rawLine": "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"ping\",\"params\":{\"x\":\"SENTINEL_PARSE_M11_C\"},}",
      "expect": {
        "jsonrpc": "2.0",
        "id": null,
        "error": {
          "code": -32700,
          "message": {
            "$match": "string"
          },
          "data": {
            "$match": "any",
            "optional": true
          }
        }
      }
    },
    {
      "note": "truncated tools/call",
      "send": null,
      "rawLine": "{\"jsonrpc\":\"2.0\",\"id\":8,\"method\":\"tools/call\",\"params\":{\"name\":\"report_status\",\"arguments\":{\"status\":\"SENTINEL_PARSE_M11_D",
      "expect": {
        "jsonrpc": "2.0",
        "id": null,
        "error": {
          "code": -32700,
          "message": {
            "$match": "string"
          },
          "data": {
            "$match": "any",
            "optional": true
          }
        }
      }
    },
    {
      "note": "single quotes",
      "send": null,
      "rawLine": "{'jsonrpc':'2.0','id':9,'method':'ping','x':'SENTINEL_PARSE_M11_E'}",
      "expect": {
        "jsonrpc": "2.0",
        "id": null,
        "error": {
          "code": -32700,
          "message": {
            "$match": "string"
          },
          "data": {
            "$match": "any",
            "optional": true
          }
        }
      }
    },
    {
      "note": "ping still answers",
      "send": {
        "jsonrpc": "2.0",
        "id": 10,
        "method": "ping"
      },
      "rawLine": null,
      "expect": {
        "jsonrpc": "2.0",
        "id": 10,
        "result": {}
      }
    }
  ],
  "stderrForbidden": ["initialize", "notifications/initialized", "ping", "tools/call"],
  "absentStrings": [
    "SENTINEL_PARSE_M11_A",
    "SENTINEL_PARSE_M11_B",
    "SENTINEL_PARSE_M11_C",
    "SENTINEL_PARSE_M11_D",
    "SENTINEL_PARSE_M11_E"
  ]
}
