    {
      "note": "collector working",
      "event": {
        "type": "heartbeat",
        "status": "working",
        "toolName": null,
        "errorCode": null,
        "agent": null,
        "receivedAt": "2026-10-30T10:00:03Z",
        "sequence": 3
      },
      "expect": {
        "status": "working",
        "statusSource": "collector",
        "statusReason": null,
        "needsAttention": false
      }
    }
  ]
