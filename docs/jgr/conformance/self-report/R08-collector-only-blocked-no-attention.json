      "note": "collector blocked: no attention",
      "event": {
        "type": "heartbeat",
        "status": "blocked",
        "toolName": null,
        "errorCode": null,
        "agent": null,
        "receivedAt": "2026-10-30T10:00:01Z",
        "sequence": 1
      },
      "expect": {
        "status": "blocked",
        "statusSource": "collector",
        "statusReason": null,
        "needsAttention": false
