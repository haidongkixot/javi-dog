{
  "name": "javis-dog",
  "private": true,
  "description": "Javi's Dog — Every agent. One clear signal.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint && eslint scripts",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "modules:registry": "node scripts/modules-registry.mjs",
    "docs:lint": "markdownlint-cli2",
    "docs:links": "node scripts/check-links.mjs",
    "docs:drift": "node scripts/doc-drift.mjs",
    "docs:check": "pnpm docs:lint && pnpm docs:links && node scripts/modules-registry.mjs --check && pnpm --filter @javis-dog/ui tokens:check && pnpm docs:drift",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "markdownlint-cli2": "0.23.3",
    "prettier": "3.9.10",
    "turbo": "2.11.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
