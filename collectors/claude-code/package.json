{
  "name": "@javis-dog/collector-claude-code",
  "version": "0.1.0",
  "private": true,
  "description": "JD-C01 — Claude Code collector: `javi` CLI and command hooks mapped to JGR (operational metadata only)",
  "type": "module",
  "bin": {
    "javi": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "javi": "node src/cli.ts",
    "build": "node scripts/build.mjs",
    "pack:cli": "node scripts/pack.mjs",
    "e2e:smoke": "node scripts/e2e-smoke.mjs"
  },
  "dependencies": {
    "@javis-dog/collector-adapters": "workspace:*",
    "@javis-dog/collector-mcp-server": "workspace:*",
    "@javis-dog/crypto": "workspace:*",
    "@javis-dog/jgr-sdk": "workspace:*",
    "@javis-dog/jgr-spec": "workspace:*",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@javis-dog/event-store": "workspace:*",
    "@javis-dog/ingest": "workspace:*",
    "@javis-dog/projects": "workspace:*",
    "@javis-dog/realtime": "workspace:*",
    "@types/node": "22.20.5",
    "drizzle-orm": "0.45.4",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
