# Javi's Dog — environment variable NAMES only. Never commit values.
# Status of each resource: docs/agent-ops/READINESS_MATRIX.md

# B1 — Neon Postgres (S2)
DATABASE_URL=

# B3 — GitHub OAuth (S2)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# B4 — Google OAuth (S2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Better Auth (S2)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# B5 — Resend (S2)
RESEND_API_KEY=
EMAIL_FROM=

# Vercel Cron → /api/cron/purge-events (S3b, ADR-0009). Vercel sends it as a bearer token.
CRON_SECRET=

# B6 — GitHub App bridge (S5g, ADR-0019). The webhook secret is Sensitive; the others are public ids.
# GITHUB_APP_WEBHOOK_SECRET_PREVIOUS only during a rotation, then removed (D0 L5).
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_WEBHOOK_SECRET_PREVIOUS=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_OWNER_ID=
